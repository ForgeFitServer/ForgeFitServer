# Copy this file to .env and run: docker compose up -d

# === REQUIRED ===
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080

# === OPTIONAL ===
# RP_NAME=Forge Fitness Server
# AUTH_MODE=all                          # all | passkey | password
# SESSION_SECRET=<long-random-string>    # For persistent sessions across restarts
# BRAND_NAME=Forge Fitness Server
# ADMIN_UIDS=userid1,userid2             # Comma-separated admin user IDs
# INVITE_ONLY=false                      # Require invite code for signup

# See README.md or docs for deployment & advanced options
